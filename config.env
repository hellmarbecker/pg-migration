# Shared settings for all scripts. Override any value via the environment,
# e.g. AWS_PROFILE=other ./scripts/01-create-rds.sh

# AWS account / region (Frankfurt)
: "${AWS_PROFILE:=default}"
: "${AWS_REGION:=eu-central-1}"

# Source RDS instance
: "${RDS_INSTANCE_ID:=pg-migration-source}"
: "${RDS_INSTANCE_CLASS:=db.t4g.micro}"
: "${RDS_STORAGE_GB:=20}"
: "${RDS_PG_MAJOR:=17}"
: "${RDS_DB_NAME:=shop}"
: "${RDS_MASTER_USER:=pgadmin}"
: "${RDS_PARAM_GROUP:=pg-migration-source-pg${RDS_PG_MAJOR}}"
: "${RDS_SECURITY_GROUP:=pg-migration-source-sg}"
: "${RDS_SUBNET_GROUP:=pg-migration-source-public}"

# Target: ClickHouse Managed Postgres (via clickhousectl)
: "${CH_ORG_ID:=1736eee7-36c8-43f2-aa10-41e1de403a5d}"   # HB's Organization
: "${CH_PG_NAME:=pg-migration-target}"
: "${CH_PG_REGION:=eu-central-1}"
: "${CH_PG_VERSION:=17}"               # same major as the source
: "${CH_PG_SIZE:=r6gd.medium}"         # smallest: 1 vCPU, 8 GB RAM, 59 GB NVMe

# Migration (ClickPipes "Data sources" import into Managed Postgres)
: "${MIG_SCHEMA:=shop}"                     # source schema to migrate
: "${MIG_TARGET_DB:=shop}"                  # empty database on the target
: "${CLICKPIPES_USER:=clickpipes_user}"     # replication user on RDS
: "${CLICKPIPES_PUBLICATION:=clickpipes_shop}"

# Sample data volume
: "${SAMPLE_CUSTOMERS:=10000}"
: "${SAMPLE_PRODUCTS:=1000}"
: "${SAMPLE_ORDERS:=100000}"

export AWS_PROFILE AWS_REGION
