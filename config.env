# Shared settings for all scripts. Override any value via the environment,
# e.g. AWS_PROFILE=other ./scripts/01-create-rds.sh

# AWS account / region (Frankfurt)
: "${AWS_PROFILE:=default}"
: "${AWS_REGION:=eu-central-1}"

# Source RDS instance
: "${RDS_INSTANCE_ID:=pg-migration-source}"
: "${RDS_INSTANCE_CLASS:=db.t4g.micro}"
: "${RDS_STORAGE_GB:=20}"
: "${RDS_PG_MAJOR:=17}"
: "${RDS_DB_NAME:=shop}"
: "${RDS_MASTER_USER:=pgadmin}"
: "${RDS_PARAM_GROUP:=pg-migration-source-pg${RDS_PG_MAJOR}}"
: "${RDS_SECURITY_GROUP:=pg-migration-source-sg}"
: "${RDS_SUBNET_GROUP:=pg-migration-source-public}"

# Sample data volume
: "${SAMPLE_CUSTOMERS:=10000}"
: "${SAMPLE_PRODUCTS:=1000}"
: "${SAMPLE_ORDERS:=100000}"

export AWS_PROFILE AWS_REGION
